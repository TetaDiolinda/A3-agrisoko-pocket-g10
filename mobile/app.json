{
  "expo": {
    "name": "AgriSoko Pocket G10",
    "slug": "agrisoko-pocket-g10",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "rw.ac.ines.agrisokopocket.g10",
      "versionCode": 1,
      "adaptiveIcon": {
